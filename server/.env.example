PORT=5000
NODE_ENV=development

# Local development uses the portable PostgreSQL cluster on port 55432.
# For a standard PostgreSQL install, swap this for port 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/sweety_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/sweety_test

JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
